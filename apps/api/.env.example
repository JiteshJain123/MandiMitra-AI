# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/mandimitra

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---- Gnani AI (backend only; never expose to the frontend) ----
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_BASE_URL=https://api.vachana.ai
# Prisma output format: transcribe (inverse text normalisation, digits) | verbatim | codemix | transliterate
GNANI_STT_FORMAT=transcribe
GNANI_TIMEOUT_MS=30000

# ---- Demo ----
# Enables the "Try demo account" button (synthetic data only)
DEMO_MODE_ENABLED=true
# Days after transaction date a payment becomes overdue when no due date is given (0 disables)
DEFAULT_PAYMENT_TERM_DAYS=15
